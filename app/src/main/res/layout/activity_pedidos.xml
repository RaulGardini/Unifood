<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#123B63"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <TextView
            android:text="Pedido"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvCodigoPedido"
            android:text="#UF-2847"
            android:textColor="#CFCFCF"
            android:textSize="14sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CARD STATUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:orientation="horizontal">

                <!-- TIMELINE -->
                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <!-- verde -->
                    <!-- Ponto 1 -->
                    <View
                        android:id="@+id/ponto1"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#4CAF50" />

                    <!-- Linha 1 -->
                    <View
                        android:id="@+id/linha1"
                        android:layout_width="2dp"
                        android:layout_height="40dp"
                        android:background="#4CAF50"/>

                    <!-- Ponto 2 -->
                    <View
                        android:id="@+id/ponto2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#4CAF50"/>

                    <!-- Linha 2 -->
                    <View
                        android:id="@+id/linha2"
                        android:layout_width="2dp"
                        android:layout_height="40dp"
                        android:background="#DDDDDD"/>

                    <!-- Ponto 3 -->
                    <View
                        android:id="@+id/ponto3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#FF6B00"/>

                    <!-- Linha 3 -->
                    <View
                        android:id="@+id/linha3"
                        android:layout_width="2dp"
                        android:layout_height="40dp"
                        android:background="#DDDDDD"/>

                    <!-- Ponto 4 -->
                    <View
                        android:id="@+id/ponto4"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#CCCCCC"/>

                </LinearLayout>

                <!-- TEXTOS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvStatus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pedido recebido"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14:32 - Confirmado"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvStatus2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Em preparo"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14:34 - Iniciado"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvStatus3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pronto para retirada"
                        android:textStyle="bold"
                        android:textColor="#FF6B00"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimativa: ~10 min"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvStatus4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entregue"
                        android:textStyle="bold"
                        android:textColor="#BBBBBB"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aguardando..."
                        android:textColor="#BBBBBB"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- RESUMO -->
            <LinearLayout
                android:id="@+id/containerResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/tvTotalPedido"
                android:textColor="#FF6B00"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="end"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- BOTÃO -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Cancelar pedido"
                android:textColor="#D32F2F"
                android:background="@drawable/bg_botao_cancelar"
                android:textAllCaps="false"
                android:layout_marginTop="20dp"/>

        </LinearLayout>

    </ScrollView>
    <!-- BOTTOM NAV BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:gravity="center">

        <!-- INICIO -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/indicatorInicio"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="@android:color/transparent"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="#888888"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- PEDIDOS (ATIVO) -->
        <LinearLayout
            android:id="@+id/navPedidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">


            <View
                android:id="@+id/indicatorPedidos"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="#FF6B00"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedidos"
                android:textColor="#FF6B00"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/indicatorPerfil"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:background="@android:color/transparent"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#888888"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>